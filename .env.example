# ---------------------------------------------------------------
# Copy this file to `.env` and fill in the values for your server.
# ---------------------------------------------------------------

# Backend (Supabase / Postgres) — used by the browser app
VITE_SUPABASE_URL="http://localhost:8000"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
VITE_SUPABASE_PROJECT_ID="local"

# Same values for server-side rendering
SUPABASE_URL="http://localhost:8000"
SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"

# Server-only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Direct Postgres connection (only needed to run the SQL in db/full-schema.sql)
DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres"

# Optional: email delivery, if you later enable outgoing email
EMAIL_SERVICE_API_KEY=""

# Port the Node server listens on behind IIS
PORT="3000"
